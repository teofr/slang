{%- set lexer = model.parser.lexer -%}

use serde::Serialize;
use strum::Display;

#[derive(Clone, Copy, Debug, Display, Eq, Hash, PartialEq, PartialOrd, Ord, Serialize)]
pub enum TerminalKind {
    #[allow(clippy::upper_case_acronyms)]
    UNRECOGNIZED,

    {% for terminal in lexer.all_terminal_kinds -%}
        {{ terminal }},
    {% endfor %}
}
