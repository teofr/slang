{%- set target = model.ir_language_model.target -%}
#![allow(unused)]
use std::ops::Range;
use std::sync::Arc;

use slang_solidity_v2_common::files::FileId;
use slang_solidity_v2_common::nodes::NodeId;
use slang_solidity_v2_ir::ir;
use slang_solidity_v2_semantic::context::SemanticContext;
use super::types::Type;

//
// Sequences
//

{% for parent_type, sequence in target.sequences %}
  pub type {{ parent_type }}<'a> = {{ parent_type }}Struct<'a>;

  #[derive(Clone, Copy)]
  pub struct {{ parent_type }}Struct<'a> {
    pub(crate) ir_node: &'a ir::{{ parent_type }},
    pub(crate) semantic: &'a SemanticContext,
  }

  pub fn create_{{ parent_type | snake_case }}<'a>(
    ir_node: &'a ir::{{ parent_type }},
    semantic: &'a SemanticContext,
  ) -> {{ parent_type }}<'a> {
    {{ parent_type }}Struct {
      ir_node,
      semantic,
    }
  }

  impl<'a> {{ parent_type }}Struct<'a> {
    pub fn node_id(&self) -> NodeId {
      self.ir_node.id()
    }
    {% for field in sequence.fields -%}
      {% if field.field_type.is_external %}
        pub fn {{ field.label }}(&self) -> {% if field.is_optional %}Option<{{ field.field_type.name }}>{% else %}{{ field.field_type.name }}{% endif %} {
          self.ir_node.{{ field.label }}
        }
      {% elif field.is_optional %}
        pub fn {{ field.label }}(&self) -> Option<{{ field.field_type.name }}{% if target.borrowed[field.field_type.name] %}<'a>{% endif %}> {
          self.ir_node.{{ field.label }}.as_ref().map(|ir_node| {
            create_{{ field.field_type.name | snake_case }}(ir_node, self.semantic)
          })
        }
      {% else %} {# not field.is_optional #}
        pub fn {{ field.label }}(&self) -> {{ field.field_type.name }}{% if target.borrowed[field.field_type.name] %}<'a>{% endif %} {
          create_{{ field.field_type.name | snake_case }}(&self.ir_node.{{ field.label }}, self.semantic)
        }
      {% endif %}
    {% endfor %}

    pub fn get_type(&self) -> Option<Type<'a>> {
      Type::try_create_for_node_id(self.ir_node.id(), self.semantic)
    }

    pub fn get_file_id(&self) -> &'a FileId {
        self.semantic.file_id_from_node_id(self.ir_node.id())
    }

    pub fn get_text_range(&self) -> &'a Range<usize> {
        &self.ir_node.range
    }
  }

{% endfor %}

//
// Choices
//

{% for parent_type, choice in target.choices %}
  #[derive(Clone, Copy)]
  pub enum {{ parent_type }}{% if target.borrowed[parent_type] %}<'a>{% endif %} {
    {% for variant in choice.variants -%}
      {{ variant.name }}
      {%- if variant.is_external -%}
        (&'a {{ variant.type_name }})
      {%- elif not variant.is_unit -%}
        ({{ variant.type_name }}{% if target.borrowed[variant.type_name] %}<'a>{% endif %})
      {%- endif -%}
      ,
    {%- endfor -%}
  }

  #[allow(clippy::clone_on_copy)]
  #[allow(clippy::too_many_lines)]
  #[allow(clippy::trivially_copy_pass_by_ref)]
  pub(crate) fn create_{{ parent_type | snake_case }}<'a>(
    ir_node: &'a ir::{{ parent_type }},
    semantic: &'a SemanticContext,
  ) -> {{ parent_type }}{% if target.borrowed[parent_type] %}<'a>{% endif %} {
    match ir_node {
      {% for variant in choice.variants -%}
        ir::{{ parent_type }}::{{ variant.name }}
        {%- if variant.kind == "Collection" -%}
          (nodes) => {{ parent_type }}::{{ variant.name }}(
            create_{{ variant.type_name | snake_case }}(nodes, semantic)
          ),
        {%- elif variant.is_external -%}
          (variant) => {{ parent_type }}::{{ variant.name }}(variant),
        {%- elif not variant.is_unit -%}
          (variant) => {{ parent_type }}::{{ variant.name }}(
            create_{{ variant.type_name | snake_case }}(variant, semantic)
          ),
        {%- else -%}
          => {{ parent_type }}::{{ variant.name }},
        {%- endif -%}
      {%- endfor %}
    }
  }

{% endfor %}

//
// Repeated & Separated
//

{% for parent_type, collection in target.collections -%}
  pub type {{ parent_type }}<'a> = {{ parent_type }}Struct<'a>;

  pub(crate) fn create_{{ parent_type | snake_case }}<'a>(
    nodes: &'a ir::{{ parent_type }},
    semantic: &'a SemanticContext,
  ) -> {{ parent_type }}<'a> {
    {{ parent_type }}Struct {
      ir_nodes: nodes,
      semantic,
    }
  }

  #[derive(Clone, Copy)]
  pub struct {{ parent_type }}Struct<'a> {
    pub(crate) ir_nodes: &'a ir::{{ parent_type }},
    pub(crate) semantic: &'a SemanticContext,
  }

  impl<'a> {{ parent_type }}Struct<'a> {
    pub fn iter(&self) -> impl Iterator<Item = {{ collection.item_type.name }}{% if target.borrowed[collection.item_type.name] %}<'a>{% endif %}> + use<'a> {
      let semantic = self.semantic;
      self.ir_nodes
          .iter()
          .map(move |ir_node| create_{{ collection.item_type.name | snake_case }}(ir_node, semantic))
    }

    pub fn len(&self) -> usize {
      self.ir_nodes.len()
    }

    pub fn is_empty(&self) -> bool {
      self.ir_nodes.is_empty()
    }
  }
{% endfor %}

//
// Terminals
//

{% for terminal_type, terminal in target.terminals %}
  pub type {{ terminal_type }}<'a> = {{ terminal_type }}Struct<'a>;

  #[derive(Clone, Copy)]
  pub struct {{ terminal_type }}Struct<'a> {
    pub(crate) ir_node: &'a ir::{{ terminal_type }},
    pub(crate) semantic: &'a SemanticContext,
  }

  pub(crate) fn create_{{ terminal_type | snake_case }}<'a>(
    ir_node: &'a ir::{{ terminal_type }},
    semantic: &'a SemanticContext,
  ) -> {{ terminal_type }}<'a> {
    {{ terminal_type }}Struct {
      ir_node,
      semantic,
    }
  }

  impl<'a> {{ terminal_type }}Struct<'a> {
    pub fn node_id(&self) -> NodeId {
      self.ir_node.id()
    }

      pub fn unparse(&self) -> &'a str {
        self.ir_node.unparse()
      }

    pub fn get_type(&self) -> Option<Type<'a>> {
      Type::try_create_for_node_id(self.ir_node.id(), self.semantic)
    }

    pub fn get_file_id(&self) -> &'a FileId {
        self.semantic.file_id_from_node_id(self.ir_node.id())
    }

    pub fn get_text_range(&self) -> &'a Range<usize> {
        &self.ir_node.range
    }
  }
{% endfor %}
