use std::ops::Range;

use slang_solidity_v2_common::terminals::TerminalKind;
use strum::{Display, EnumString, IntoStaticStr};

#[derive(Debug)]
pub struct Lexeme {
    pub kind: LexemeKind,
    pub range: Range<usize>,
}

#[derive(Clone, Debug, Display, EnumString, IntoStaticStr, PartialEq)]
#[allow(clippy::upper_case_acronyms, non_camel_case_types)]
pub enum LexemeKind {
    UNRECOGNIZED,

    {% for kind in model.parser.lexer.all_lexeme_kinds -%}
        {{ kind }},
    {% endfor %}
}

impl LexemeKind {
    /// The terminal to name when reporting this lexeme in the list of terminals
    /// the parser expected.
    ///
    /// That is the lexeme's own terminal, except for the unreserved lexeme of a
    /// keyword the grammar never uses: the parser only ever accepts it in place
    /// of an identifier, so naming the keyword would be noise.
    pub fn expected_terminal(&self) -> TerminalKind {
        match self {
            {% for lexeme, identifier in model.parser.lexer.identifier_stand_in_lexemes -%}
                Self::{{ lexeme }} => TerminalKind::{{ identifier }},
            {% endfor -%}
            _ => TerminalKind::from(self),
        }
    }

    pub fn is_trivia(&self) -> bool {
        matches!(
            self,
            {% for kind in model.parser.lexer.trivia_lexeme_kinds -%}
                Self::{{ kind }}
                {% if not loop.last %} | {% endif %}
            {% endfor %}
        )
    }
}

#[allow(clippy::too_many_lines)]
impl From<&LexemeKind> for TerminalKind {
    fn from(kind: &LexemeKind) -> Self {
        match kind {
            LexemeKind::UNRECOGNIZED => TerminalKind::UNRECOGNIZED,

            {% for kind in model.parser.lexer.all_lexeme_kinds -%}
                {% if model.parser.lexer.trivia_lexeme_kinds is not containing(pat=kind) -%}
                    LexemeKind::{{ kind }} => TerminalKind::{{ kind | replace(from="_Reserved", to="") | replace(from="_Unreserved", to="") }},
                {% endif -%}
            {%- endfor %}

            {% for kind in model.parser.lexer.trivia_lexeme_kinds -%}
                LexemeKind::{{ kind }} => unreachable!("Trivia lexeme kind: {kind:?}"),
            {%- endfor %}
        }
    }
}
